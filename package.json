{
  "name": "kaicut",
  "version": "0.1.0",
  "private": true,
  "description": "KaiCut / 开剪 - local-first desktop video editor shell",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build": "tsc -b && vite build",
    "lint": "eslint src mcp vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "node mcp/server.mjs",
    "test:mcp": "node --test mcp/*.test.mjs",
    "mcp:smoke": "node mcp/smoke.mjs",
    "mcp:live-check": "node mcp/live-check.mjs",
    "mcp:workflow-check": "node mcp/workflow-check.mjs",
    "mcp:export-check": "node mcp/workflow-check.mjs --export",
    "mcp:preview-check": "node mcp/preview-check.mjs",
    "mcp:playback-check": "node mcp/playback-check.mjs",
    "mcp:startup-check": "node mcp/startup-check.mjs",
    "native:clock-probe": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features native-clock-probe --example native_clock_probe --",
    "native:media-probe": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features native-media-probe --example native_media_probe --",
    "native:d3d-probe": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features native-d3d-probe --example native_d3d_probe --",
    "native:queue-probe": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features native-queue-probe --example native_queue_probe --",
    "native:stream-probe": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features native-stream-probe --example native_stream_probe --",
    "native:compat-probe": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features native-stream-probe --example native_compat_probe --",
    "native:audio-timing-probe": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features native-stream-probe --example native_audio_timing_probe --",
    "native:audio-transport-probe": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features native-stream-probe --example native_audio_transport_probe --",
    "native:audio-session-probe": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features native-stream-probe --example native_audio_session_probe --",
    "native:av-session-probe": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features native-stream-probe --example native_av_session_probe --",
    "native:present-probe": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features native-present-probe --example native_present_probe --",
    "native:av-present-probe": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features native-av-present-probe --example native_av_present_probe --",
    "native:surface-probe": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features native-surface-probe --example native_surface_probe --",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
